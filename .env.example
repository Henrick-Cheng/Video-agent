# ── Copy this file to .env and fill in your values ───────────────────────────
# .env is gitignored; .env.example is committed as documentation.

# DashScope API key (required when backend = "dashscope")
# Get yours at: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# vLLM API key (required when backend = "vllm"; default "token-abc" is fine locally)
VLLM_API_KEY=token-abc

# ── Optional overrides (override configs/default.yaml values) ─────────────────
# Switch backend:
# BACKEND=vllm

# Use higher-quality model:
# MODELS__VL__MODEL_NAME=qwen-vl-max-latest
# MODELS__LLM__MODEL_NAME=qwen-max-latest

# Custom endpoints:
# MODELS__VL__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLLM__VL__BASE_URL=http://localhost:8001/v1

# Enable mock mode (skip real API calls in tests):
# MOCK__ENABLED=true
